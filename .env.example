# PostgreSQL / PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=municipal_db
POSTGRES_PORT=5432

# Backend Database Connection URL
# For Docker Compose networking:
DATABASE_URL=postgresql://postgres:postgres@database:5432/municipal_db

# For local development outside Docker (e.g. running uvicorn locally with db mapped to localhost:5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/municipal_db
